    {
      "id": "POST /credentials/{secret}",
      "service": "credential-manager",
      "kind": "route_handler",
      "name": "Handle Credentials",
      "input": "CredentialRequest { action: CredentialAction, params: Value }",
      "output": "Response",
      "mutates_state": true,
      "mutation_target": "order_credentials",
      "defined_in": "src/server/handlers.rs",
      "description": "Main endpoint. Dispatches to generate/retrieve/update/retrieve_private_key based on (AuthType, CredentialAction) match. 401 on mismatch, 400 on bad deserialization.",
      "method": "POST",
      "path_pattern": "/credentials/{secret}",
      "handler": "server::handlers::handle_credentials",
      "source_code": "pub async fn handle_credentials(State(state): State<Arc<HandlerState>>, Extension(auth_type): Extension<AuthType>, Json(request_body): Json<CredentialRequest>) -> Response {\n    match (auth_type, request_body.action) {\n        (AuthType::Generate, CredentialAction::Generate) => { match serde_json::from_value::<GenerateRequest>(request_body.params) { Ok(req) => handle_generate_credentials(&state, req.secret_hash, req.source_chain, req.destination_chain).await, Err(_) => api::bad_request(\"Invalid request\").into_response() } }\n        (AuthType::Retrieve, CredentialAction::Retrieve) => { match serde_json::from_value::<RetrieveRequest>(request_body.params) { Ok(req) => handle_retrieve_credentials(&state, req.secret_hashes).await, Err(_) => api::bad_request(\"Invalid request\").into_response() } }\n        (AuthType::Retrieve, CredentialAction::Update) => { match serde_json::from_value::<UpdateRequest>(request_body.params) { Ok(req) => handle_update_credentials(&state, req.secret).await, Err(_) => api::bad_request(\"Invalid request\").into_response() } }\n        (AuthType::RetrievePrivateKey, CredentialAction::RetrievePrivateKey) => { match serde_json::from_value::<RetrieveRequest>(request_body.params) { Ok(req) => handle_retrieve_private_keys(&state, req.secret_hashes).await, Err(_) => api::bad_request(\"Invalid request\").into_response() } }\n        _ => create_unauthorized_response()\n    }\n}",
      "example_payload": "{\"action\":\"generate\",\"source_chain\":\"bitcoin\",\"destination_chain\":\"spark\"}"
    },
