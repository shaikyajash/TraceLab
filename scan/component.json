      "source_code": "fn generate_address_for_chain(pk: &[u8;32], chain: ChainType, is_testnet: bool, cm: &CredentialsManager) -> Result<Option<String>> { if !chain_requires_private_key(chain) { return Ok(None); } match chain { ChainType::Bitcoin|ChainType::Litecoin|ChainType::Alpen => generate_x_only_public_key(...).map(Some), ChainType::Spark => generate_spark_address(pk, network).map(Some), ChainType::Zcash => generate_compressed_public_key(...).map(Some), _ => Ok(None) } }"
