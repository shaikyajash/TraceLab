      "description": "Extracts secret from URL path, looks up in HashMap, inserts AuthType. 401 if unknown.",
      "source_code": "fn call(&mut self, req: Request) -> Self::Future { ... let secret = path.rsplit('/').find(|s| !s.is_empty()); let auth_type = state.secret_to_auth_type.get(secret)?; req.extensions_mut().insert(auth_type); ... }"
    },
    {
      "id": "handle_generate_credentials",
      "service": "credential-manager",
      "kind": "business_logic",
      "name": "Handle Generate Credentials",
      "input": "HandlerState, Option<String>, ChainType, ChainType",
      "output": "Response with GenerateCredentialsResponse",
      "mutates_state": true,
      "mutation_target": "order_credentials",
      "defined_in": "src/server/handlers.rs",
      "description": "Validates chains/hash, determines needs_private_key, generates credentials, derives addresses.",
      "source_code": "async fn handle_generate_credentials(state: &Arc<HandlerState>, secret_hash: Option<String>, source_chain: ChainType, destination_chain: ChainType) -> Response { if let Err(e) = validate_chains(source_chain, destination_chain) { return bad_request; } if let Some(ref h) = secret_hash { validate_secret_hash(h)?; } let needs_pk = chain_requires_private_key(source_chain) || chain_requires_private_key(destination_chain); let creds = state.credentials_manager.generate_and_store_credentials(secret_hash, needs_pk).await?; let (src_addr, dst_addr) = generate_addresses(&creds.private_key, source_chain, destination_chain, state.is_testnet, &state.credentials_manager)?; Ok(GenerateCredentialsResponse { secret_hash: creds.secret_hash, source_address: src_addr, destination_address: dst_addr }) }"
    },
